{
  "name": "v2i-esp32s3-vercel-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent V2I emergency-vehicle traffic signal preemption: ESP32-S3 + nRF24L01+ PA+LNA, Next.js on Vercel, Claude MCP tools",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp": "tsx mcp-server/v2i-mcp-server.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/scan-secrets.mjs",
    "test:firmware": "node scripts/test-firmware.mjs",
    "sync:firmware": "node scripts/sync-firmware-headers.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
